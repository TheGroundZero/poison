# https://github.com/super-linter/super-linter/blob/main/docs/run-linter-locally.md#share-environment-variables-between-environments
VALIDATE_ALL_CODEBASE=false
FIX_CSS=true
FIX_CSS_PRETTIER=true
FIX_HTML_PRETTIER=true
FIX_MARKDOWN_PRETTIER=true
FIX_MARKDOWN=true
FIX_YAML_PRETTIER=true
# ENABLE_GITHUB_PULL_REQUEST_SUMMARY_COMMENT=true
# UPDATE_EXISTING_GITHUB_PULL_REQUEST_SUMMARY_COMMENT=true
# SAVE_SUPER_LINTER_SUMMARY=true
ENABLE_GITHUB_PULL_REQUEST_SUMMARY_COMMENT=false
UPDATE_EXISTING_GITHUB_PULL_REQUEST_SUMMARY_COMMENT=false
SAVE_SUPER_LINTER_SUMMARY=false